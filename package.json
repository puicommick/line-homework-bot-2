{
  "name": "line-homework-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:create": "wrangler d1 create homework_db",
    "db:migrate:local": "wrangler d1 migrations apply homework_db --local",
    "db:migrate:remote": "wrangler d1 migrations apply homework_db --remote",
    "db:seed:local": "wrangler d1 execute homework_db --local --file=./seeds/demo.sql",
    "richmenu": "node scripts/create-rich-menu.mjs"
  },
  "dependencies": {
    "hono": "^4.6.14",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241205.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "wrangler": "^4.0.0"
  }
}
